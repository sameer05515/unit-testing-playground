<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Express App</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    />
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
    ></script>
    <style>
      body {
        background-color: black;
      }
      .file-list {
        max-height: calc(100vh - 75px);
        overflow-y: auto;
      }
      .pdf-container {
        min-height: calc(100vh - 75px);
      }
    </style>
  </head>

  <body
    x-data="comicApp()"
  >
    <script>
      function comicApp() {
        return {
          showList: false && window.innerWidth > 768,
          search: '',
          files: <%- JSON.stringify(files) %>,
          bookmarks: <%- JSON.stringify(bookmarks || []) %>,
          currentSlug: <%- JSON.stringify(slug || "") %>,
          bookmarkBusy: false,
          bookmarkMessage: "",
          get isBookmarked() { return this.bookmarks.includes(this.currentSlug); },
          async toggleBookmark() {
            if (!this.currentSlug || this.bookmarkBusy) return;
            this.bookmarkBusy = true;
            this.bookmarkMessage = "";
            try {
              const response = this.isBookmarked
                ? await fetch(`/pdf-viewer/v1/bookmarks/${encodeURIComponent(this.currentSlug)}`, { method: "DELETE" })
                : await fetch("/pdf-viewer/v1/bookmarks", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ slug: this.currentSlug })
                  });
              const result = await response.json();
              if (!response.ok) throw new Error(result.error || "Bookmark update failed");
              this.bookmarks = result.bookmarks;
              this.bookmarkMessage = this.isBookmarked ? "Bookmarked" : "Bookmark removed";
            } catch (error) {
              this.bookmarkMessage = error.message || "Unable to update bookmark";
            } finally {
              this.bookmarkBusy = false;
            }
          },
          async toggleBookmarkFor(targetSlug) {
            try {
              const response = await fetch(`/pdf-viewer/v1/bookmarks/${encodeURIComponent(targetSlug)}`, { method: "DELETE" });
              const result = await response.json();
              if (!response.ok) throw new Error(result.error || "Unable to remove bookmark");
              this.bookmarks = result.bookmarks;
              this.bookmarkMessage = "Bookmark removed";
            } catch (error) { this.bookmarkMessage = error.message || "Unable to remove bookmark"; }
          },
          get bookmarkedFiles() { return this.files.filter(file => this.bookmarks.includes(file.slug)); },
          get filteredFiles() {
            if (!this.search.trim()) return this.files;
            return this.files.filter(f =>
              f.slug.toLowerCase().includes(this.search.toLowerCase())
            );
          },
        };
      }
    </script>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary p-2 shadow">
      <a class="navbar-brand fw-bold" href="/">My App</a>

      <div class="d-flex flex-grow-1 justify-content-center">
        <% if (details) { %>
        <span class="badge bg-light text-dark p-2 rounded">
          <strong><%= slug %></strong> &middot;
          <%= details.currentIndex + 1 %> / <%= files.length %>
        </span>
        <% } %>
      </div>

      <div class="d-flex gap-2">
        <button class="btn btn-light" @click="showList = !showList">
          📂
        </button>
        <% if (details) { %>
        <button class="btn" :class="isBookmarked ? 'btn-warning' : 'btn-outline-light'" @click="toggleBookmark()" :disabled="bookmarkBusy" :title="isBookmarked ? 'Remove bookmark' : 'Bookmark this PDF'">
          <span x-text="isBookmarked ? '★ Saved' : '☆ Bookmark'"></span>
        </button>
        <a
          href="/pdf-viewer/v1/?slug=<%= details.prevSlug %>"
          title="Prev"
          class="btn btn-outline-light"
          >⏪</a
        >
        <a
          href="/pdf-viewer/v1/?slug=<%= details.nextSlug %>"
          title="Next"
          class="btn btn-outline-light"
          >⏩</a
        >
        <% } %>
      </div>
    </nav>

    <!-- Main Container -->
    <div class="container-fluid mt-1">
      <div class="row">
        <!-- Sidebar (File List + Filter Input) -->
        <div
          id="listCol"
          x-show="showList"
          x-transition
          class="col-md-3 col-lg-2 file-list bg-dark text-white p-2"
        >
          <div class="mb-2">
            <input
              type="text"
              class="form-control form-control-sm"
              placeholder="🔍 Filter comics..."
              x-model="search"
            />
          </div>

          <div class="d-flex justify-content-between align-items-center mt-3 mb-2">
            <strong>Bookmarks</strong><span class="badge bg-warning text-dark" x-text="bookmarks.length"></span>
          </div>
          <div class="small text-info mb-2" role="status" x-text="bookmarkMessage"></div>
          <ul class="list-group mb-3">
            <template x-for="file in bookmarkedFiles" :key="'bookmark-' + file.slug">
              <li class="list-group-item bg-dark border-warning d-flex align-items-center gap-2">
                <a :href="`/pdf-viewer/v1/?slug=${encodeURIComponent(file.slug)}`" class="text-decoration-none text-warning text-break flex-grow-1" x-text="file.slug"></a>
                <button class="btn btn-sm btn-outline-warning" @click="toggleBookmarkFor(file.slug)" title="Remove bookmark" aria-label="Remove bookmark">×</button>
              </li>
            </template>
            <li class="list-group-item bg-dark text-secondary" x-show="bookmarkedFiles.length === 0">No bookmarks yet.</li>
          </ul>

          <div class="fw-bold mb-2">All PDFs</div>
          <ul class="list-group">
            <template x-for="file in filteredFiles" :key="file.slug">
              <li
                class="text-break list-group-item bg-dark border-light"
                :class="{'active': '<%= slug %>' === file.slug}"
              >
                <a
                  :href="`/pdf-viewer/v1/?slug=${file.slug}`"
                  class="text-decoration-none text-light d-block p-2"
                  x-text="file.slug"
                ></a>
              </li>
            </template>
          </ul>
        </div>

        <!-- PDF Viewer -->
        <div
          id="contentCol"
          :class="showList ? 'col-md-9 col-lg-10' : 'col-12'"
          class="pdf-container"
        >
          <% if (details) { %>
          <iframe
            src="/pdf-viewer/v1/pdf/<%= slug %>"
            width="100%"
            height="100%"
            style="border: 1px solid #ddd;"
          ></iframe>
          <% } else { %>
          <p class="text-muted">Select a file to view details.</p>
          <% } %>
        </div>
      </div>
    </div>
  </body>
</html>
